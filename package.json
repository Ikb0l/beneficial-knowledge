{
  "name": "beneficial-knowledge",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "cd client && npm run dev",
    "dev:server": "docker-compose --env-file .env -f docker/docker-compose.dev.yml up",
    "dev:admin": "cd admin && npm run dev",
    "dev:all": "concurrently \"npm run dev:client\" \"npm run dev:admin\" \"npm run dev:server\"",
    "build": "npm run build:client && npm run build:server",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "build:admin": "cd admin && npm run build",
    "server:build": "cd server && npm run build",
    "server:watch": "cd server && npm run build:watch",
    "test:server": "cd server && npm run test",
    "test:e2e:tournament": "node scripts/tournament-e2e-smoke.mjs",
    "test:production": "npm run check && npm run build && npm run build:admin && npm run docker:up && npm run db:migrate && npm run test:server && npm run test:e2e:tournament",
    "docker:up": "docker-compose --env-file .env -f docker/docker-compose.dev.yml up -d",
    "docker:down": "docker-compose --env-file .env -f docker/docker-compose.dev.yml down",
    "docker:logs": "docker-compose --env-file .env -f docker/docker-compose.dev.yml logs -f",
    "docker:restart": "docker-compose --env-file .env -f docker/docker-compose.dev.yml restart nakama",
    "db:migrate": "docker-compose --env-file .env -f docker/docker-compose.dev.yml run --rm app-migrations",
    "db:seed": "cd server && npm run seed",
    "env:check:prod": "powershell -ExecutionPolicy Bypass -File server/scripts/check-env-security.ps1",
    "lint:client": "cd client && npm run lint",
    "lint:admin": "cd admin && npm run lint",
    "lint": "concurrently \"npm run lint:client\" \"npm run lint:admin\"",
    "type-check:server": "cd server && npm run type-check",
    "check": "npm run type-check:server && npm run lint",
    "install:all": "npm install && cd client && npm install && cd ../server && npm install && cd ../admin && npm install",
    "tunnel:client": "cloudflared tunnel --url http://localhost:5200",
    "tunnel:admin": "cloudflared tunnel --url http://localhost:3001",
    "tunnel:nakama": "cloudflared tunnel --url http://localhost:7350",
    "tunnel:all": "concurrently \"npm run tunnel:client\" \"npm run tunnel:admin\" \"npm run tunnel:nakama\"",
    "tunnel:telegram": "node scripts/setup-telegram-tunnel.mjs",
    "prod:prepare": "node scripts/prepare-production-env.mjs --output .env.production.ready",
    "prod:deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy-production.ps1",
    "prod:deploy:telegram": "powershell -ExecutionPolicy Bypass -File scripts/deploy-with-telegram-tunnel.ps1",
    "prod:check:linux": "node scripts/check-env-security.mjs --env-file .env.production.ready",
    "prod:deploy:linux": "bash scripts/deploy-production.sh",
    "prod:deploy:vps": "bash scripts/deploy-vps-remote.sh"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
